# ==============================================================================
# GARRO — Environment Variables Template
# ==============================================================================
# Copy this file to .env and insert the API key for your chosen provider:
#     cp .env.example .env
#
# Only the API key for the provider selected in config.yaml [agentic] is required.
# If you don't use LLM intent features or use Ollama (local), you can skip this.
# ==============================================================================

# ── Google Gemini (FREE — Recommended default) ────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
# Models: gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Groq (FREE — Ultra-fast inference with LPUs) ───────────────────────────────
# Get a free API key at: https://console.groq.com
# Models: llama3-70b-8192, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY="your_groq_api_key_here"

# ── Ollama (LOCAL & FREE — 100% offline, no API key needed!) ──────────────────
# 1. Install Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 2. Pull model:     ollama pull llama3
# 3. Set in config.yaml: provider: "ollama"  |  model: "llama3"
OLLAMA_BASE_URL="http://localhost:11434"

# ── OpenAI (PAID) ─────────────────────────────────────────────────────────────
# Get an API key at: https://platform.openai.com/api-keys
# Models: gpt-4o-mini, gpt-4o
OPENAI_API_KEY="your_openai_api_key_here"

# ── Mistral AI (FREE Trial credits available) ─────────────────────────────────
# Get an API key at: https://console.mistral.ai
# Models: mistral-small-latest, open-mistral-7b
MISTRAL_API_KEY="your_mistral_api_key_here"

# ── Cohere (FREE Trial credits available) ─────────────────────────────────────
# Get an API key at: https://dashboard.cohere.com
# Models: command-r, command-r-plus
COHERE_API_KEY="your_cohere_api_key_here"

# ── Together AI ($5 free trial credits) ───────────────────────────────────────
# Get an API key at: https://api.together.xyz
# Models: meta-llama/Llama-3-70b-chat-hf, mistralai/Mixtral-8x7B-Instruct-v0.1
TOGETHER_API_KEY="your_together_api_key_here"
